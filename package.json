{
  "name": "chelcoach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "vitest run",
    "test:server": "npm --prefix server test",
    "test:pg": "npm --prefix server run test:pg",
    "test:shared": "npm --prefix shared test",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test --project=chromium e2e/journeys/golden-path.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:browsers": "playwright test --project=chromium --project=firefox-smoke --project=webkit-smoke",
    "test:all": "npm run test:shared && npm run test:frontend && npm run test:server && npm run test:pg && npm run build && npm run lint && npm run test:e2e",
    "verify:product": "bash scripts/verify-product.sh",
    "audit:deps": "npm audit --omit=dev; npm --prefix server audit --omit=dev; true",
    "audit:bundle": "node scripts/scan-bundle-secrets.mjs",
    "audit:security-scan": "node scripts/scan-server-security.mjs",
    "cleanup:media": "node scripts/cleanup-media.mjs",
    "db:migrate": "npm --prefix server run db:migrate",
    "verify:supabase-db": "npm --prefix server run verify:supabase-db",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "material-symbols": "^0.45.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.30.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.7"
  }
}
