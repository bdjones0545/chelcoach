# ChelCoach environment template.
# Copy to `.env` (gitignored) and fill in secrets locally.
# Never commit real API keys or database passwords.

# =============================================================================
# Frontend (Vite)
# =============================================================================
VITE_USE_BACKEND_REPORTS=false
VITE_API_BASE_URL=
# Leave empty for local/E2E development_session. Required on Vercel for browser Auth.
# Vite embeds these at build time — redeploy without cache after changing them.
# See docs/vercel-auth-environment.md. Never put SERVICE_ROLE or DATABASE_URL here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================================================
# Supabase API (server-side)
# =============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Media storage (Step 10.1C) — local_disk for CI/dev; supabase_storage for production path
# =============================================================================
CHELCOACH_MEDIA_STORAGE_MODE=local_disk
CHELCOACH_PRODUCTION_MEDIA_STORAGE_READY=false
SUPABASE_GAMEPLAY_BUCKET=chelcoach-gameplay
SUPABASE_DERIVED_MEDIA_BUCKET=chelcoach-derived-media
# CHELCOACH_MAX_CONCURRENT_UPLOADS_PER_USER=3
# CHELCOACH_MAX_PENDING_UPLOADS_PER_USER=3

# Media inspection worker (Step 10.1D) — never inline on Vercel/supabase
# CHELCOACH_MEDIA_INSPECTION_MODE=worker
# CHELCOACH_INSPECTION_WORKER_SECRET=
# CHELCOACH_INSPECTION_WORKER_INLINE=0
# CHELCOACH_INSPECTION_TMPDIR=
# CHELCOACH_LIVE_MEDIA_WORKER_VERIFY=1

# =============================================================================
# Supabase / Postgres (Step 10.1A) — required for durable Drizzle repositories
# =============================================================================
# Runtime connection (prefer Supabase session or transaction pooler URI).
DATABASE_URL=
# Optional: direct DB URI for migrations (db.<project>.supabase.co:5432).
# Falls back to DATABASE_URL when unset.
DATABASE_URL_MIGRATE=
# auto | direct | pooler | local
CHELCOACH_DB_CONNECTION_MODE=auto
# require | verify-full | disable (Supabase requires require/verify-full)
CHELCOACH_DB_SSL_MODE=require
# Optional override; defaults to server/certs/supabase-pooler-chain.pem for Supabase.
# CHELCOACH_DB_SSL_CA_PATH=
CHELCOACH_DB_STATEMENT_TIMEOUT_MS=15000
CHELCOACH_DB_MAX_CONNECTIONS=5

# =============================================================================
# Vercel (deployment later — not used in Step 10.1A)
# =============================================================================
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=

# =============================================================================
# Backend — see server/.env.example for Scotty / security flags
# =============================================================================
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
# CHELCOACH_ANALYSIS_SUBMISSION_ENABLED=false
# CHELCOACH_SCOTTIE_ENABLED=false

# Auth (Step 10.1B) — production: supabase_auth + PRODUCTION_AUTH_READY=true
CHELCOACH_AUTH_MODE=development_session
# Alias: existing_auth + CHELCOACH_EXISTING_AUTH_PROVIDER=supabase
# Production: CHELCOACH_AUTH_MODE=supabase_auth
CHELCOACH_EXISTING_AUTH_PROVIDER=supabase
CHELCOACH_PRODUCTION_AUTH_READY=false
CHELCOACH_ANALYSIS_SUBMISSION_ENABLED=false
CHELCOACH_SCOTTIE_ENABLED=false
