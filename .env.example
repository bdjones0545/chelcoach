# ChelCoach frontend environment (Vite). Copy to `.env.local` to override.
# All vars are optional — the app runs on mock data with none of these set.

# Read the analysis report from the backend API instead of local mock data.
# Default (unset / anything but "true") = OFF → current mockData behavior, unchanged.
VITE_USE_BACKEND_REPORTS=false

# Backend API base URL (used only when VITE_USE_BACKEND_REPORTS=true).
VITE_API_BASE_URL=http://localhost:3001

# Publish read-only tools to AI agents via WebMCP. See src/webmcp/README.md.
# Default (unset) = OFF → no tools registered, behavior unchanged.
VITE_WEBMCP_ENABLED=false

# Also serve those tools to browsers with no native WebMCP, by lazily loading
# the @mcp-b/global polyfill into its own chunk.
VITE_WEBMCP_POLYFILL=false
