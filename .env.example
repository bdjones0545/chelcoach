# ChelCoach environment template.
# Copy to `.env` (gitignored) and fill in secrets locally.
# Never commit real API keys.

# =============================================================================
# Frontend (Vite) — only VITE_* vars are exposed to the browser bundle
# =============================================================================
VITE_USE_BACKEND_REPORTS=false
VITE_API_BASE_URL=http://localhost:3001

# Supabase (browser-safe anon key only on the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================================================
# Supabase (server-side) — keep service role off the frontend
# =============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Supabase Postgres connection string
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# =============================================================================
# Vercel
# =============================================================================
# Personal / team token from https://vercel.com/account/tokens
VERCEL_TOKEN=
# From project Settings → General (or `vercel link`)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=

# =============================================================================
# Backend — see server/.env.example for full Scotty / security flags
# =============================================================================
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
# DATABASE_URL=
