# ChelCoach backend environment
# Copy to `.env` (or set as Replit Secrets). The server boots without any of these set.

# API server port.
PORT=3001

# Comma-separated allowed origins for CORS (e.g. the Vite dev URL / deployed frontend).
# Leave empty in local dev to allow all.
CORS_ORIGIN=

# Object storage backend (Phase 2): "memory" | "replit".
# Auto-selected when unset: "replit" on Replit (REPL_ID present), otherwise "memory".
# CI + local dev use "memory" (no secret / paid service required).
STORAGE_BACKEND=

# Postgres connection string (Replit PostgreSQL / Neon). Not required yet — used from the
# database phase onward.
DATABASE_URL=

# --- Media / FFmpeg extraction (Phase 3; all optional) ---
# FFMPEG_PATH=
# FFPROBE_PATH=
# MEDIA_MAX_DURATION_SEC=180
# MEDIA_MAX_FRAMES=12
# MEDIA_MAX_FRAME_WIDTH=1280
# MEDIA_MAX_PIXELS=2073600
# MEDIA_PROCESS_TIMEOUT_MS=60000
# MEDIA_MAX_PROCESS_OUTPUT_BYTES=65536
# MEDIA_MAX_CONCURRENT_JOBS=1
# MEDIA_EDGE_SKIP_FRACTION=0.05
# MEDIA_JPEG_QUALITY=3

# --- AI gameplay analysis (Phase 4) ---
# ANTHROPIC_API_KEY=            # required for live Anthropic analysis
# ANTHROPIC_MODEL=claude-sonnet-5
# AI_PROVIDER=anthropic         # anthropic | fake
# AI_REQUEST_TIMEOUT_MS=90000
# AI_MAX_ATTEMPTS=2
# AI_RETRY_BACKOFF_MS=750
# AI_MAX_FRAMES=12
# AI_MAX_IMAGE_BYTES=1500000
# AI_MAX_TOTAL_IMAGE_BYTES=12000000
# AI_MAX_OUTPUT_TOKENS=8192
