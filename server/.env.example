# ChelCoach backend environment (Phase 0)
# Copy to `.env` (or set as Replit Secrets). The server boots without these in Phase 0;
# the DB is only required once real routes are wired.

# Postgres connection string (Replit PostgreSQL / Neon).
DATABASE_URL=

# API server port.
PORT=3001

# Comma-separated allowed origins for CORS (e.g. the Vite dev URL / deployed frontend).
# Leave empty in local dev to allow all.
CORS_ORIGIN=

# --- Reserved for later phases (do NOT set yet) ---
# ANTHROPIC_API_KEY=            # Phase 4 — real AI analysis
# OBJECT_STORAGE_BUCKET=        # Phase 1 — clip/frame storage
