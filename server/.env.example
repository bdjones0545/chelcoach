# ChelCoach backend environment
# Copy to `.env` (or set as Replit Secrets). The server boots without any of these set.

# API server port.
PORT=3001

# Comma-separated allowed origins for CORS (e.g. the Vite dev URL / deployed frontend).
# Leave empty in local dev to allow all.
CORS_ORIGIN=

# Object storage backend (Phase 2): "memory" | "replit".
# Auto-selected when unset: "replit" on Replit (REPL_ID present), otherwise "memory".
# CI + local dev use "memory" (no secret / paid service required).
STORAGE_BACKEND=

# Postgres connection string (Supabase / Neon / local).
# Prefer pooler URI for runtime; optional direct URI for migrations.
DATABASE_URL=
DATABASE_URL_MIGRATE=
CHELCOACH_DB_CONNECTION_MODE=auto
CHELCOACH_DB_SSL_MODE=require
CHELCOACH_DB_STATEMENT_TIMEOUT_MS=15000
CHELCOACH_DB_MAX_CONNECTIONS=5

# --- Scotty upload retention (Step 1) ---
# CHELCOACH_RAW_MEDIA_RETENTION_HOURS=24
# CHELCOACH_RAW_MEDIA_MAX_RETENTION_HOURS=48
# CHELCOACH_MAX_UPLOAD_BYTES=2147483648

# --- Scotty upload sessions (Step 2) ---
# CHELCOACH_PENDING_UPLOAD_EXPIRATION_HOURS=2
# Disk-backed streamed media objects (default: OS temp /chelcoach-media)
# CHELCOACH_MEDIA_DIR=
# Force in-memory profile/upload repos even when DATABASE_URL is set (tests)
# CHELCOACH_FORCE_MEMORY_REPOS=1

# --- Scotty player identification (Step 3) ---
# CHELCOACH_PLAYER_IDENTITY_CONFIDENCE_THRESHOLD=0.75
# CHELCOACH_CONFIRMATION_FRAME_MAX_EDGE=1280
# CHELCOACH_CONFIRMATION_FRAME_MAX_BYTES=500000
# CHELCOACH_ALLOW_IDENTITY_FIXTURES=1
# CHELCOACH_USE_FFMPEG_FRAMES=1
# Legacy buffered demo upload hard-cap (default 50 MiB)
# CHELCOACH_LEGACY_UPLOAD_MAX_BYTES=52428800

# --- Scotty provider boundary (Step 4) ---
# CI default remains fake. Local async lifecycle: set provider=simulator.
# CHELCOACH_ANALYSIS_PROVIDER=simulator
# CHELCOACH_SCOTTIE_ENABLED=false
# SCOTTY_BASE_URL=
# SCOTTY_CONTRACT_VERSION=1.0.0
# SCOTTY_REQUEST_TIMEOUT_MS=30000
# SCOTTY_STATUS_TIMEOUT_MS=10000
# SCOTTY_REPORT_TIMEOUT_MS=30000
# SCOTTY_SIGNING_SECRET=
# CHELCOACH_FAKE_PROVIDER_SCENARIO=accept
# CHELCOACH_SCOTTY_CALLBACKS_ENABLED=

# --- Scotty local lifecycle simulator (Step 5) ---
# CHELCOACH_SCOTTY_SIMULATOR_ENABLED=true
# CHELCOACH_SCOTTY_SIMULATOR_ALLOW_IN_PRODUCTION=false
# SCOTTY_SIMULATOR_DEFAULT_SCENARIO=auto
# SCOTTY_SIMULATOR_QUEUED_MS=1000
# SCOTTY_SIMULATOR_INSPECTING_MS=1500
# SCOTTY_SIMULATOR_EXTRACTING_MS=2000
# SCOTTY_SIMULATOR_IDENTIFYING_MS=1500
# SCOTTY_SIMULATOR_ANALYZING_MS=4000
# SCOTTY_SIMULATOR_VALIDATING_MS=1500
# SCOTTY_SIMULATOR_FINALIZING_MS=1000
# SCOTTY_SIMULATOR_MAX_JOB_AGE_MS=120000
# SCOTTY_SIMULATOR_POLL_MS=1000

# --- Durable analysis jobs (Step 6) ---
# When DATABASE_URL is set (and not forced to memory), jobs/reports/simulator
# rows persist in Postgres. Apply migrations: npm run db:push (or generate).
# CHELCOACH_FORCE_MEMORY_REPOS=1
# Reconciliation cron (once per minute suggested):
# CHELCOACH_RECONCILE_SECRET=
# POST /api/internal/analysis/reconcile  header: x-chelcoach-reconcile-secret
# Postgres integration tests:
# CHELCOACH_RUN_PG_TESTS=1

# --- Reserved for later phases ---
# ANTHROPIC_API_KEY=
# SCOTTY_GATEWAY_URL=
